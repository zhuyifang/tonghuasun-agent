{
  "mcpServers": {
    "fqgate": {
      "type": "stdio",
      "command": "node",
      "args": ["${CODEBUDDY_PLUGIN_ROOT}/scripts/launch-fqgate-mcp.mjs"],
      "cwd": "${CODEBUDDY_PLUGIN_ROOT}",
      "env": {
        "FQGATE_MCP_TEXT_COMPATIBILITY": "true"
      },
      "x-workbuddy": {
        "displayName": {
          "zh": "同花顺免费开源AI插件FQGate",
          "en": "FQGate"
        },
        "description": {
          "zh": "连接本机 FQGate，查询行情、账户和交易记录。",
          "en": "Connect to local FQGate for market and account data."
        },
        "icon": "./assets/brand/fqgate-app-icon.svg",
        "auth": {
          "type": "none"
        }
      }
    }
  }
}
