{
  "apiVersion": "qwen-agent/plugin/v1",
  "id": "tonghuasun-agent",
  "name": "同花顺 Agent",
  "version": "0.2.13",
  "description": "在千问中查询当前电脑上的同花顺行情、Level2、账户、持仓、委托和成交数据。",
  "author": "zhuyifang",
  "homepage": "https://github.com/zhuyifang/tonghuasun-agent",
  "license": "AGPL-3.0-only",
  "mcpServers": {
    "tonghuasun-agent": {
      "command": "node",
      "args": [
        "${QWEN_PLUGIN_ROOT}/scripts/tonghuasun-mcp-proxy.mjs"
      ],
      "env": {
        "TONGHUASUN_MCP_TEXT_COMPATIBILITY": "true"
      }
    }
  },
  "skills": [
    {
      "name": "tonghuasun-agent",
      "path": "./skills/tonghuasun-agent"
    }
  ]
}
